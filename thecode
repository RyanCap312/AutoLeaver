        AddWindow.Visible = false

        refreshIDList()
    end
end)

--==================================================
-- CHECK PLAYER ID
--==================================================

local function isBlockedUser(player)

    for _, userId in ipairs(blockedUserIds) do
        if player.UserId == userId then
            return true
        end
    end

    return false
end

local function checkPlayerID(player)

    if player ~= LocalPlayer and isBlockedUser(player) then

        LocalPlayer:Kick(
            "Blocked Player detected: " ..
            tostring(player.UserId)
        )

        return true
    end

    return false
end

-- Check everyone already in the server
for _, player in ipairs(Players:GetPlayers()) do
    checkPlayerID(player)
end

-- Check players who join later
Players.PlayerAdded:Connect(function(player)
    task.wait(0.1)

    if enabled then
        checkPlayerID(player)
    end
end)

--==================================================
-- PROXIMITY DETECTION
--==================================================

local function checkPlayers()

    if not enabled then
        return
    end

        local myCharacter = LocalPlayer.Character
        local myRoot = myCharacter
            and myCharacter:FindFirstChild("HumanoidRootPart")

        if not myRoot then
            return
        end

            for _, player in ipairs(Players:GetPlayers()) do

                if player ~= LocalPlayer then

                    -- Check UserId
                    if isBlockedUser(player) then
                        LocalPlayer:Kick(
                            "Blocked Player detected: " ..
                            tostring(player.UserId)
                        )
                        return
                    end

                    -- Check distance
                    local character = player.Character
                    local root = character
                        and character:FindFirstChild("HumanoidRootPart")

                    if root then

                        local distance =
                            (root.Position - myRoot.Position).Magnitude

                        if distance <= detectionDistance then

                            LocalPlayer:Kick(
                                "Player detected within " ..
                                tostring(detectionDistance) ..
                                " studs."
                            )

                            return
                        end
                    end
                end
            end
        end
task.spawn(function()

    while true do

        if enabled then
            checkPlayers()
        end

        task.wait(0.2)
    end
end)

--==================================================
-- MINIMIZE / RESTORE
--==================================================

local minimized = false

local function toggleMinimize()

    minimized = not minimized

    if minimized then

        Main.Size = UDim2.new(0, 150, 0, 35)

        DistanceLabel.Visible = false
        DistanceBox.Visible = false
        IDListButton.Visible = false
        AddIDButton.Visible = false
        Rebind.Visible = false

        Minimize.Text = "+"

    else

        Main.Size = UDim2.new(0, 300, 0, 210)

        DistanceLabel.Visible = true
        DistanceBox.Visible = true
        IDListButton.Visible = true
        AddIDButton.Visible = true
        Rebind.Visible = true

        Minimize.Text = "-"
    end
end

Minimize.MouseButton1Click:Connect(toggleMinimize)

--==================================================
-- REBIND MINIMIZE KEY
--==================================================

local rebinding = false

Rebind.MouseButton1Click:Connect(function()

    rebinding = true
    Rebind.Text = "Press any key..."

    local connection

    connection = UserInputService.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.Keyboard then

            minimizeKey = input.KeyCode

            Rebind.Text =
                "Rebind Minimize Key: " ..
                input.KeyCode.Name

            rebinding = false

            connection:Disconnect()
        end
    end)
end)

UserInputService.InputBegan:Connect(function(input, processed)

    if not processed and not rebinding then

        if input.KeyCode == minimizeKey then
            toggleMinimize()
        end
    end
end)

--==================================================
-- DRAGGING
--==================================================

local dragging = false
local dragStart
local startPosition

Title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = true
        dragStart = input.Position
        startPosition = Main.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)

    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then

        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

